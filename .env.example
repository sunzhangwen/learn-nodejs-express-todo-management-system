# JWT secret key (required in production)
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=3000

# CORS allowed origins (comma-separated, * for all)
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_username
DB_PASS=your_password
DB_DIALECT=mysql

# Node environment
NODE_ENV=development

# AI provider (optional; deterministic local fallback is used when unset)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5-pro
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1600
AI_CHAT_MAX_TOKENS=700
AI_CHAT_CONTEXT_LIMIT=5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional Qdrant Cloud vector search backend for RAG
AI_RAG_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tasks
QDRANT_DISTANCE=Cosine
